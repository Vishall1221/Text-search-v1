# Copy to .env and adjust for your machine. Never commit a real password.
DATABASE_URL=postgresql://ai_search@127.0.0.1:5432/ai_search
API_HOST=127.0.0.1
API_PORT=8000
LLM_BASE_URL=http://127.0.0.1:8081
LLM_MODEL=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
LLM_TIMEOUT_SECONDS=30
LLM_ENABLED=true
CATALOG_CACHE_SECONDS=60
CANDIDATE_LIMIT=250
SCENES_PER_TITLE=60
